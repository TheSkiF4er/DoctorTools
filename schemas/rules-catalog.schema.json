{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitflic.ru/skif4er/doctortools/schemas/rules-catalog.schema.json",
  "title": "DoctorTools Rules Catalog",
  "description": "JSON Schema каталога правил DoctorTools 3.x с поддержкой product/profile-aware правил.",
  "type": "object",
  "required": ["version", "rules"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "module": {
      "type": "string",
      "minLength": 1,
      "description": "Legacy-идентификатор модуля для совместимости со встроенным каталогом CraftDoctor."
    },
    "product": {
      "type": "string",
      "minLength": 1,
      "description": "Ключ продукта DoctorTools: craftdoctor, stackdoctor, depdoctor, configdoctor, deploydoctor, apidoctor, botdoctor или logdoctor."
    },
    "profile": {
      "type": "string",
      "minLength": 1,
      "description": "Профиль/область применения правил внутри продукта."
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "severity", "category", "title", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "product": { "type": "string", "minLength": 1 },
          "profile": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["INFO", "WARN", "DANGER", "CRITICAL"] },
          "category": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "recommendation": { "type": "string" }
        }
      }
    }
  }
}
