# .craftdoctor-secrets-ignore
# Файл allowlist для осознанного подавления false-positive секретов.
# Использовать осторожно: правило скрывает находку Security Doctor 2.0.

# Подавить все находки в конкретном файле:
file:plugins/Example/config.yml

# Подавить строку, содержащую известный тестовый маркер:
line:example-false-positive-token

# Подавить тип находки:
kind:Bearer token

# Допускаются простые glob/substring-шаблоны по пути:
plugins/TestOnly/*.yml
